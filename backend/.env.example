# ─── Database ──────────────────────────────────────────────────────────────
# For development (local PostgreSQL):
DATABASE_URL=postgresql+asyncpg://kyuna:devpassword123@localhost:5432/kyuna_db

# For development (SQLite fallback — not recommended):
# DATABASE_URL=sqlite+aiosqlite:///./app.db

# ─── Auth ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Services ──────────────────────────────────────────────────────────────
AI_SERVER_URL=http://localhost:8001
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=100

# CORS — comma separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173, http://localhost:3000

# App mode: development | production
ENVIRONMENT=development

