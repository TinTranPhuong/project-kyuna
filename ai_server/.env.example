# ══════════════════════════════════════════
# AI SERVER — /ai_server/.env
# ══════════════════════════════════════════

# Default GGUF model filename (must exist in ai_server/models/)
DEFAULT_MODEL=llama-3.1-8b-instruct-q4_k_m.gguf

# Path to the models directory
MODELS_DIR=./models

# GPU layers: -1 = all layers on GPU, 0 = CPU only
N_GPU_LAYERS=-1

# Context window (tokens). Larger = more memory.
N_CTX=4096

# CPU threads for inference (set to your CPU core count)
N_THREADS=8

# Max simultaneous inference requests before queuing
MAX_CONCURRENT_REQUESTS=3

# Port for AI server
PORT=8001