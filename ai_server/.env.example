# ╔══════════════════════════════════════════════════════════════════╗
# ║           Kyuna AI Server — .env Config Example                  ║
# ║   Copy this file to .env and adjust the paths to your models.    ║
# ╚══════════════════════════════════════════════════════════════════╝

# Port for AI server
PORT=8001

# ── AI Server Models ───────────────────────────────────────────────────
# Point this to the folder where all your .gguf files live
MODELS_DIR=./app/models

# The filenames of the models inside the MODELS_DIR
DEFAULT_MODEL=llm.gguf
CHAT_MODEL=llm.gguf
TRANSLATION_MODEL=llm.gguf
VISION_MODEL=llm.gguf
MMPROJ_FILE=mmproj-llm.gguf
DETECTOR_MODEL=comictextdetector.pt

# HuggingFace model cache (manga-ocr downloads here automatically)
HF_HOME=./models/hf_cache

# ── VRAM Auto-Offload ──────────────────────────────────────────────────
# Script reads layer count from the GGUF file automatically.
# It then fits as many layers as possible under VRAM_LIMIT_GB.
AUTO_GPU_LAYERS=true

# Hard VRAM ceiling in GB. 15.5 for 16gb VRAM GPU.
VRAM_LIMIT_GB=15.5

# Manual fallback — only used when AUTO_GPU_LAYERS=false
# -1 = all layers to GPU | 0 = CPU only | N = partial
N_GPU_LAYERS=-1

# ── CPU / Threading ────────────────────────────────────────────────────
# CPU threads for inference (set to your CPU core count)
N_THREADS=8

# ── Context Window ─────────────────────────────────────────────────────
# Tokens the model can "see" at once.
# KV Q4 makes 32k viable on 16 GB — see KV Cache section below.
# Common values: 4096 | 8192 | 16384 | 32768 
N_CTX=32768

# ── Batching ───────────────────────────────────────────────────────────
N_BATCH=512
N_UBATCH=512

# ── KV Cache Quantization ──────────────────────────────────────────────
# Quantizes the attention KV cache to save VRAM.
# Essential for 32k context on 16 GB VRAM — cuts cache from ~4 GB → ~1 GB.
#
# Type values:
#   1 = FP16  — full precision, most VRAM  (~4.0 GB at 32k)
#   2 = Q4_0  — 4-bit, ~4x less VRAM      (~1.0 GB at 32k)
#   8 = Q8_0  — 8-bit, ~2x less VRAM      (~2.0 GB at 32k)
KV_TYPE_K=8
KV_TYPE_V=8

# ── Memory Options ─────────────────────────────────────────────────────
FLASH_ATTN=true    # faster generation, saves ~10% VRAM (needs CUDA build)
USE_MMAP=true      # faster model load
USE_MLOCK=false    # lock model in RAM (set true only if you have spare RAM)

# ── Generation Defaults ────────────────────────────────────────────────
MAX_TOKENS=32768
TEMPERATURE=0.7    # 0.0 = deterministic, 1.0+ = creative
TOP_P=0.9
TOP_K=40
REPEAT_PENALTY=1.1

# ── Debug / Think Block ────────────────────────────────────────────────
# RAW_OUTPUT: print every token exactly as the model generates it.
# Shows <think>...</think> tags, partial outputs, everything.
# true / false
RAW_OUTPUT=false

# Max tokens the model can spend inside a <think> block.
MAX_THINK_TOKENS=20000 

# ── Logging ────────────────────────────────────────────────────────────
VERBOSE=false      # show llama.cpp internal logs
LOG_FILE=

# ── Embedding Model ───────────────────────────────────────────────
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=32