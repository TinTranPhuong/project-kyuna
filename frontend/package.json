    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "latest",
    "autoprefixer": "^10.4.27",
    "eslint": "latest",
    "postcss": "^8.5.6",
    "prettier": "latest",
    "tailwindcss": "^3.4.19",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
