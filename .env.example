# ══════════════════════════════════════════
# BACKEND — /backend/.env
# ══════════════════════════════════════════

# Database connection string
# SQLite (dev): sqlite+aiosqlite:///./app.db
# PostgreSQL (prod): postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./app.db

# JWT Security — generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Server URL (internal service URL)
AI_SERVER_URL=http://localhost:8001

# File upload config
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=100

# CORS — comma separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# App mode: development | production
ENVIRONMENT=development

# ══════════════════════════════════════════
# AI SERVER — /ai_server/.env
# ══════════════════════════════════════════

# Default GGUF model filename (must exist in ai_server/models/)
DEFAULT_MODEL=llama-3.1-8b-instruct-q4_k_m.gguf

# Path to the models directory
MODELS_DIR=./models

# GPU layers: -1 = all layers on GPU, 0 = CPU only
N_GPU_LAYERS=-1

# Context window (tokens). Larger = more memory.
N_CTX=4096

# CPU threads for inference (set to your CPU core count)
N_THREADS=8

# Max simultaneous inference requests before queuing
MAX_CONCURRENT_REQUESTS=3

# Port for AI server
PORT=8001

# ══════════════════════════════════════════
# FRONTEND — /frontend/.env
# ══════════════════════════════════════════

# Backend API URL (used by Axios)
VITE_API_URL=http://localhost:8000

# App display name
VITE_APP_NAME=Kyuna Space

# Default lo-fi music URL
VITE_DEFAULT_MUSIC_URL=https://www.youtube.com/watch?v=jfKfPfyJRdk